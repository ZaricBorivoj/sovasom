{
  "name": "office-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check-types && vite build",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --ci --no-open",
    "build-storybook": "storybook build",
    "test:storybook": "playwright test --config playwright.components.config.ts --grep-invert @visual",
    "test:visual": "playwright test --config playwright.components.config.ts --grep @visual",
    "test:e2e": "playwright test",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "storybook": "10.6.8",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "@babel/core": "8.1.3",
    "@babel/eslint-parser": "8.1.2",
    "@babel/preset-typescript": "8.0.7",
    "@babel/preset-react": "8.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "*.{css,json,html,md}": "prettier --write"
  },
  "engines": {
    "node": "26.13.1"
  }
}
