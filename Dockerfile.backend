FROM ghcr.io/astral-sh/uv:0.13.9 AS uv
FROM python:3.15.2-slim AS base
COPY --from=uv /uv /uvx /bin/
WORKDIR /app
ENV PYTHONPATH=/app/backend UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev
COPY alembic.ini ./
COPY backend backend

FROM base AS test
RUN uv sync --frozen
CMD ["uv", "run", "--frozen", "pytest", "-q"]

FROM base AS runtime
RUN useradd --uid 10001 --create-home office
USER office
EXPOSE 8000
CMD ["uv", "run", "--frozen", "--no-dev", "uvicorn", "office.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
