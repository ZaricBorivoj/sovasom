# Copy to .env, set credentials, then run: uv run --frozen python scripts/setup.py
# Keep .env private (chmod 600). Use single quotes for literal secret values.
DATABASE_PASSWORD=''
PUBLIC_ORIGIN=https://localhost:8443
SITE_ADDRESS=localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# First setup only. These entries are removed automatically after initialization.
INITIAL_EMAIL=''
INITIAL_DISPLAY_NAME=''
INITIAL_PASSWORD=''
